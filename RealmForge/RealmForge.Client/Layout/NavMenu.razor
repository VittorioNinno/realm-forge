@using RealmForge.Client.Localization
@using RealmForge.Client.Services
@implements IDisposable
@inject LanguageStateService LanguageState

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand d-flex align-items-center gap-2" href="">
            <span class="brand-title fw-bold" style="color: var(--rf-orange-primary);">RealmForge</span>
        </a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill" aria-hidden="true"></span> @UiText.NavDashboard(LanguageState.CurrentLanguage)
            </NavLink>
        </div>
        @* --- SPECIES NAVIGATION ITEM --- *@
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="species">
                <span class="bi bi-person-badge-fill" aria-hidden="true"></span> @UiText.NavSpecies(LanguageState.CurrentLanguage)
            </NavLink>
        </div>
        @* --- FEATS NAVIGATION ITEM --- *@
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="feats">
                <span class="bi bi-award-fill me-2" aria-hidden="true"></span>
                @UiText.FeatsTitle(LanguageState.CurrentLanguage)
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    protected override void OnInitialized()
    {
        LanguageState.OnLanguageChanged += StateHasChanged;
    }

    public void Dispose()
    {
        LanguageState.OnLanguageChanged -= StateHasChanged;
    }
}