@page "/species/{ParentSpeciesId:guid}/subspecies"
@using RealmForge.Client.Components
@using RealmForge.Client.Localization
@using RealmForge.Client.Services
@using RealmForge.Domain.DTOs
@using RealmForge.Domain.Enums
@implements IDisposable
@inject SubspeciesDataService SubspeciesService
@inject SpeciesDataService SpeciesService
@inject LanguageStateService LanguageState
@inject NavigationManager NavManager

<PageTitle>RealmForge - @UiText.SubspeciesTitle(LanguageState.CurrentLanguage)</PageTitle>

<div class="container-fluid px-0 py-4">
    @* Page Header *@
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4 pb-3" style="border-bottom: 2px solid var(--rf-orange-primary);">
        <div>
            <button class="btn btn-sm btn-rf-outline mb-3 text-uppercase" style="letter-spacing: 1px;" @onclick="GoBack">
                @UiText.BtnBackToSpecies(LanguageState.CurrentLanguage)
            </button>
            <h1 class="h3 fw-bold mb-1 rf-page-title">
                @UiText.SubspeciesTitle(LanguageState.CurrentLanguage)
                @if (!string.IsNullOrEmpty(parentSpeciesName))
                {
                    <span class="text-secondary fw-light"> / @parentSpeciesName</span>
                }
            </h1>
            <p class="mb-0 small" style="color: var(--rf-text-muted); letter-spacing: 1px; text-transform: uppercase;">
                @UiText.SubspeciesSubtitle(LanguageState.CurrentLanguage)
            </p>
        </div>

        <div>
            <button class="btn btn-rf-orange" @onclick="OpenCreateModal">
                @UiText.BtnAddSubspecies(LanguageState.CurrentLanguage)
            </button>
        </div>
    </div>

    @* Error Alert *@
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger bg-dark border-danger text-light mb-4">
            @errorMessage
        </div>
    }

    @* --- SUBSPECIES GRID --- *@
    @if (isLoading)
    {
        <div class="text-center my-5 py-5">
            <div class="spinner-border" style="color: var(--rf-orange-primary);" role="status"></div>
            <p class="mt-3" style="color: var(--rf-text-muted); text-transform: uppercase; letter-spacing: 1px;">
                @UiText.LoadingArchives(LanguageState.CurrentLanguage)
            </p>
        </div>
    }
    else if (!subspeciesList.Any())
    {
        <div class="p-4 rounded text-center" style="background-color: var(--rf-bg-surface); border: 1px solid var(--rf-border-light);">
            <p class="mb-0" style="color: var(--rf-text-muted);">
                @UiText.NoSubspeciesFound(LanguageState.CurrentLanguage)
            </p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
            @foreach (var sub in subspeciesList)
            {
                <div class="col">
                    <div class="rf-card h-100 d-flex flex-column justify-content-between">
                        <div>
                            @* CARD HEADER *@
                            <div class="d-flex justify-content-between align-items-start mb-3 gap-2">
                                <span class="rf-card-title mb-0">@sub.Name</span>
                                <div class="d-flex gap-1 flex-shrink-0 align-items-center">
                                    <span class="badge @(sub.Ruleset == RulesetVersion.Dnd5e_2024 ? "badge-edition-2024" : "badge-edition-2014")">
                                        @UiText.FormatRuleset(sub.Ruleset, LanguageState.CurrentLanguage)
                                    </span>
                                    <span class="badge @(sub.IsOfficialSRD ? "badge-srd" : "badge-homebrew")">
                                        @(sub.IsOfficialSRD ? UiText.BadgeSRD(LanguageState.CurrentLanguage) : UiText.BadgeHomebrew(LanguageState.CurrentLanguage))
                                    </span>
                                </div>
                            </div>

                            @* CARD METADATA *@
                            <div class="rf-meta-row mb-3">
                                <div>
                                    <strong>@UiText.MetaSpeed(LanguageState.CurrentLanguage)</strong>
                                    <span style="color: #ffffff;">
                                        @(sub.BaseSpeedOverrideInFeet.HasValue 
                                            ? UiText.FormatSpeed(sub.BaseSpeedOverrideInFeet.Value, LanguageState.CurrentLanguage) 
                                            : "Inherited")
                                    </span>
                                </div>
                            </div>

                            @* CARD DESCRIPTION *@
                            <p class="small lh-base mb-3" style="color: var(--rf-text-secondary); text-align: left;">
                                @(string.IsNullOrWhiteSpace(sub.Description) ? UiText.NoDescription(LanguageState.CurrentLanguage) : sub.Description)
                            </p>
                        </div>

                        @* CARD FOOTER: Actions *@
                        <div class="pt-3 d-flex justify-content-end align-items-center gap-2" style="border-top: 1px solid var(--rf-border-subtle);">
                            <button class="btn btn-sm btn-rf-outline text-uppercase"
                                    style="letter-spacing: 1px;"
                                    @onclick="() => OpenEditModal(sub.Id)">
                                @UiText.Edit(LanguageState.CurrentLanguage)
                            </button>
                            <button class="btn btn-sm btn-rf-outline text-uppercase px-3"
                                    style="border-color: #dc3545; color: #dc3545;"
                                    title="@UiText.Delete(LanguageState.CurrentLanguage)"
                                    @onclick="() => OpenDeleteModal(sub.Id, sub.Name)">
                                @UiText.Delete(LanguageState.CurrentLanguage)
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@* --- CREATE / EDIT SUBSPECIES MODAL --- *@
@if (isModalOpen)
{
    <div class="rf-modal-backdrop" @onclick="CloseCreateModal">
        <div class="rf-modal-dialog" @onclick:stopPropagation="true">
            <h2 class="h4 mb-3 pb-2" style="border-bottom: 1px solid var(--rf-border-light); font-family: var(--rf-font-display);">
                @(isEditMode ? UiText.ModalTitleEditSubspecies(LanguageState.CurrentLanguage) : UiText.ModalTitleAddSubspecies(LanguageState.CurrentLanguage))
            </h2>

            @if (isModalLoading)
            {
                <div class="text-center py-4">
                    <div class="spinner-border text-warning" role="status"></div>
                </div>
            }
            else
            {
                @if (!string.IsNullOrEmpty(formValidationMessage))
                {
                    <div class="alert alert-warning bg-dark border-warning text-warning p-2 small mb-3">
                        @formValidationMessage
                    </div>
                }

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="rf-form-label d-block">@UiText.LabelRuleset(LanguageState.CurrentLanguage)</label>
                        <div class="d-flex align-items-center mt-2">
                            <span class="badge @(newRuleset == RulesetVersion.Dnd5e_2024 ? "badge-edition-2024" : "badge-edition-2014") py-2 px-3 fs-6">
                                @UiText.FormatRuleset(newRuleset, LanguageState.CurrentLanguage)
                            </span>
                            <span class="ms-2 small text-secondary fst-italic">
                                (@UiText.InheritedFromParent(LanguageState.CurrentLanguage))
                            </span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="rf-form-label">
                            @UiText.LabelSpeedOverride(LanguageState.CurrentLanguage)
                            @if (newSpeedOverride.HasValue)
                            {
                                <span class="text-secondary ms-1">(@UiText.FormatSpeed(newSpeedOverride.Value, LanguageState.CurrentLanguage))</span>
                            }
                        </label>
                        <input type="number" class="rf-form-control" @bind="newSpeedOverride" min="5" step="5" placeholder="Leave empty to inherit" />
                    </div>
                </div>

                <div class="mb-4 d-flex align-items-center">
                    <label class="rf-checkbox-wrapper mb-0">
                        <input type="checkbox" class="rf-checkbox" @bind="newIsSRD" />
                        <span class="small fw-bold" style="color: var(--rf-text-secondary);">
                            @UiText.LabelIsSRD(LanguageState.CurrentLanguage)
                        </span>
                    </label>
                </div>

                <div class="p-3 mb-3 rounded" style="background-color: var(--rf-bg-card); border-left: 3px solid var(--rf-orange-primary);">
                    <div class="fw-bold mb-2 small" style="color: var(--rf-orange-primary);">@UiText.TabItalian(LanguageState.CurrentLanguage)</div>
                    <div class="mb-2">
                        <label class="rf-form-label">@UiText.LabelName(LanguageState.CurrentLanguage)</label>
                        <input type="text" class="rf-form-control" placeholder="@UiText.PlaceholderNameIt(LanguageState.CurrentLanguage)" @bind="nameIt" />
                    </div>
                    <div>
                        <label class="rf-form-label">@UiText.LabelDescription(LanguageState.CurrentLanguage)</label>
                        <textarea class="rf-form-control" rows="2" @bind="descIt"></textarea>
                    </div>
                </div>

                <div class="p-3 mb-4 rounded" style="background-color: var(--rf-bg-card); border-left: 3px solid #666;">
                    <div class="fw-bold mb-2 small text-secondary">@UiText.TabEnglish(LanguageState.CurrentLanguage)</div>
                    <div class="mb-2">
                        <label class="rf-form-label" style="color: var(--rf-text-secondary);">@UiText.LabelName(LanguageState.CurrentLanguage)</label>
                        <input type="text" class="rf-form-control" placeholder="@UiText.PlaceholderNameEn(LanguageState.CurrentLanguage)" @bind="nameEn" />
                    </div>
                    <div>
                        <label class="rf-form-label" style="color: var(--rf-text-secondary);">@UiText.LabelDescription(LanguageState.CurrentLanguage)</label>
                        <textarea class="rf-form-control" rows="2" @bind="descEn"></textarea>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-2" style="border-top: 1px solid var(--rf-border-light);">
                    <button class="btn btn-rf-outline" @onclick="CloseCreateModal">
                        @UiText.BtnCancel(LanguageState.CurrentLanguage)
                    </button>
                    <button class="btn btn-rf-orange" @onclick="HandleSaveSubspecies" disabled="@isSaving">
                        @(isSaving ? "..." : UiText.BtnSaveSubspecies(LanguageState.CurrentLanguage))
                    </button>
                </div>
            }
        </div>
    </div>
}

@* --- DELETE CONFIRMATION MODAL --- *@
@if (isDeleteModalOpen)
{
    <div class="rf-modal-backdrop" @onclick="CloseDeleteModal">
        <div class="rf-modal-dialog" @onclick:stopPropagation="true" style="max-width: 450px; text-align: center;">
            <h2 class="h4 mb-3" style="color: var(--rf-orange-primary);">@UiText.ConfirmDeletion(LanguageState.CurrentLanguage)</h2>

            <div class="p-3 mb-4 rounded" style="background-color: var(--rf-bg-main); border: 1px solid var(--rf-border-subtle); color: var(--rf-text-secondary); line-height: 1.5;">
                @UiText.DeleteSubspeciesWarning(LanguageState.CurrentLanguage, itemToDeleteName)
            </div>

            <div class="d-flex justify-content-center gap-3">
                <button class="btn btn-rf-outline" @onclick="CloseDeleteModal">@UiText.BtnCancel(LanguageState.CurrentLanguage)</button>
                <button class="btn btn-rf-orange" style="background-color: #dc3545; border-color: #dc3545;" @onclick="HandleDeleteSubspecies">
                    @UiText.Delete(LanguageState.CurrentLanguage)
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid ParentSpeciesId { get; set; }

    private List<SubspeciesResponseDto> subspeciesList = new();
    private string parentSpeciesName = string.Empty;
    private RulesetVersion parentRuleset = RulesetVersion.Dnd5e_2024;
    
    private bool isLoading = true;
    private string? errorMessage;

    // Form Modal state
    private bool isModalOpen = false;
    private bool isModalLoading = false;
    private bool isSaving = false;
    private bool isEditMode = false;
    private Guid editingId;
    private string? formValidationMessage;

    // Form fields
    private int? newSpeedOverride = null;
    private RulesetVersion newRuleset = RulesetVersion.Dnd5e_2024;
    private bool newIsSRD = false;
    private string nameIt = "";
    private string descIt = "";
    private string nameEn = "";
    private string descEn = "";

    // Delete Modal state
    private bool isDeleteModalOpen = false;
    private Guid itemToDeleteId;
    private string itemToDeleteName = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        LanguageState.OnLanguageChanged += HandleLanguageChanged;
        await LoadData();
    }

    private async void HandleLanguageChanged()
    {
        await LoadData();
        StateHasChanged();
    }

    private async Task LoadData()
    {
        isLoading = true;
        errorMessage = null;

        var speciesDetail = await SpeciesService.GetSpeciesDetailAsync(ParentSpeciesId, LanguageState.CurrentLanguage);
        if (speciesDetail != null)
        {
            parentSpeciesName = speciesDetail.Name;
            parentRuleset = speciesDetail.Ruleset;
            subspeciesList = speciesDetail.Subspecies ?? new List<SubspeciesResponseDto>();
        }
        else
        {
            errorMessage = "Parent species not found or API error.";
        }

        isLoading = false;
    }

    private void GoBack()
    {
        NavManager.NavigateTo("/species");
    }

    private void OpenCreateModal()
    {
        isEditMode = false;
        formValidationMessage = null;
        
        newSpeedOverride = null;
        newRuleset = parentRuleset;
        newIsSRD = false;
        
        nameIt = "";
        descIt = "";
        nameEn = "";
        descEn = "";
        
        isModalOpen = true;
    }

    private async Task OpenEditModal(Guid id)
    {
        isEditMode = true;
        editingId = id;
        formValidationMessage = null;
        isModalOpen = true;
        isModalLoading = true;

        try
        {
            var detailItTask = SubspeciesService.GetByIdAsync(id, LanguageCode.It);
            var detailEnTask = SubspeciesService.GetByIdAsync(id, LanguageCode.En);

            await Task.WhenAll(detailItTask, detailEnTask);

            var detailIt = detailItTask.Result;
            var detailEn = detailEnTask.Result;

            if (detailIt != null && detailEn != null)
            {
                newSpeedOverride = detailIt.BaseSpeedOverrideInFeet;
                newRuleset = detailIt.Ruleset;
                newIsSRD = detailIt.IsOfficialSRD;

                nameIt = detailIt.Name;
                descIt = detailIt.Description;
                nameEn = detailEn.Name;
                descEn = detailEn.Description;
            }
        }
        catch (Exception ex)
        {
            formValidationMessage = $"Error loading data: {ex.Message}";
        }
        finally
        {
            isModalLoading = false;
        }
    }

    private void CloseCreateModal()
    {
        isModalOpen = false;
    }

    private async Task HandleSaveSubspecies()
    {
        if (string.IsNullOrWhiteSpace(nameIt) || string.IsNullOrWhiteSpace(nameEn))
        {
            formValidationMessage = UiText.ErrFillNames(LanguageState.CurrentLanguage);
            return;
        }

        isSaving = true;
        formValidationMessage = null;

        var translations = new List<SubspeciesTranslationDto>
        {
            new SubspeciesTranslationDto(LanguageCode.It, nameIt.Trim(), descIt?.Trim() ?? string.Empty),
            new SubspeciesTranslationDto(LanguageCode.En, nameEn.Trim(), descEn?.Trim() ?? string.Empty)
        };

        bool success = false;

        if (isEditMode)
        {
            var updateDto = new UpdateSubspeciesDto(
                editingId,
                newSpeedOverride,
                newRuleset,
                newIsSRD,
                translations
            );
            success = await SubspeciesService.UpdateAsync(editingId, updateDto);
        }
        else
        {
            var createDto = new CreateSubspeciesDto(
                newSpeedOverride,
                newRuleset,
                newIsSRD,
                translations,
                new List<CreateTraitDto>()
            );
            
            var created = await SubspeciesService.CreateAsync(ParentSpeciesId, createDto);
            success = created != null;
        }

        isSaving = false;

        if (success)
        {
            isModalOpen = false;
            await LoadData();
        }
        else
        {
            formValidationMessage = UiText.ErrApiSave(LanguageState.CurrentLanguage);
        }
    }

    private void OpenDeleteModal(Guid id, string name)
    {
        itemToDeleteId = id;
        itemToDeleteName = name;
        isDeleteModalOpen = true;
    }

    private void CloseDeleteModal()
    {
        isDeleteModalOpen = false;
    }

    private async Task HandleDeleteSubspecies()
    {
        var success = await SubspeciesService.DeleteAsync(itemToDeleteId);

        if (success)
        {
            isDeleteModalOpen = false;
            await LoadData();
        }
        else
        {
            errorMessage = LanguageState.CurrentLanguage == LanguageCode.It 
                ? "Errore durante l'eliminazione della sottospecie." 
                : "Failed to delete subspecies.";
        }
    }

    public void Dispose()
    {
        LanguageState.OnLanguageChanged -= HandleLanguageChanged;
    }
}