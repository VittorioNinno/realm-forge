@page "/species"
@using RealmForge.Client.Services
@using RealmForge.Domain.DTOs
@using RealmForge.Domain.Enums
@inject SpeciesDataService SpeciesService

<PageTitle>RealmForge - Compendio Specie</PageTitle>

<div class="container-fluid px-4 py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4 pb-3" style="border-bottom: 2px solid var(--rf-orange-primary);">
        <div>
            <h1 class="h3 fw-bold mb-1 rf-page-title">Compendio Specie</h1>
            <p class="mb-0 small" style="color: var(--rf-text-muted); letter-spacing: 1px; text-transform: uppercase;">Archivio delle specie registrate per le tue sessioni</p>
        </div>

        <div class="d-flex gap-2">
            <button class="btn @(CurrentLanguage == LanguageCode.It ? "btn-rf-orange" : "btn-rf-outline")"
                    @onclick="() => ChangeLanguage(LanguageCode.It)">
                Italiano
            </button>
            <button class="btn @(CurrentLanguage == LanguageCode.En ? "btn-rf-orange" : "btn-rf-outline")"
                    @onclick="() => ChangeLanguage(LanguageCode.En)">
                English
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center my-5 py-5">
            <div class="spinner-border" style="color: var(--rf-orange-primary);" role="status"></div>
            <p class="mt-3" style="color: var(--rf-text-muted); text-transform: uppercase; letter-spacing: 1px;">Caricamento archivio...</p>
        </div>
    }
    else if (!speciesList.Any())
    {
        <div class="p-4 rounded text-center" style="background-color: var(--rf-bg-surface); border: 1px solid var(--rf-border-light);">
            <p class="mb-0" style="color: var(--rf-text-muted);">Nessuna specie registrata nel compendio per la lingua selezionata.</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
            @foreach (var sp in speciesList)
            {
                <div class="col">
                    <div class="rf-card h-100 d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="rf-card-title">@sp.Name</span>
                                <span class="badge @(sp.IsOfficialSRD ? "badge-srd" : "badge-homebrew")">
                                    @(sp.IsOfficialSRD ? "SRD 5e" : "Homebrew")
                                </span>
                            </div>

                            <div class="rf-meta-row">
                                <div>
                                    <strong>Taglia</strong>
                                    <span style="color: #ffffff;">@sp.Size</span>
                                </div>
                                <div>
                                    <strong>Velocità</strong>
                                    <span style="color: #ffffff;">@sp.BaseSpeedInFeet ft.</span>
                                </div>
                            </div>

                            <p class="small lh-base mb-0" style="color: var(--rf-text-secondary); text-align: justify;">
                                @(string.IsNullOrWhiteSpace(sp.Description) ? "Nessuna annotazione disponibile." : sp.Description)
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<SpeciesResponseDto> speciesList = new();
    private LanguageCode CurrentLanguage = LanguageCode.It;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task ChangeLanguage(LanguageCode lang)
    {
        if (CurrentLanguage != lang)
        {
            CurrentLanguage = lang;
            await LoadData();
        }
    }

    private async Task LoadData()
    {
        isLoading = true;
        speciesList = await SpeciesService.GetSpeciesAsync(CurrentLanguage);
        isLoading = false;
    }
}